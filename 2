// TestPilot AI — Content Analyzer

(() => {
  if (window.testPilotLoaded) return;
  window.testPilotLoaded = true;

  const panel = document.createElement("div");

  panel.id = "testpilot-panel";

  panel.innerHTML = `
    <div id="tp-header">
      <span>✦ TestPilot AI</span>
      <button id="tp-close">×</button>
    </div>

    <div id="tp-content">
      <div class="tp-status">AI готов к работе</div>
      <button id="tp-analyze">Анализировать страницу</button>
      <div id="tp-result"></div>
    </div>
  `;

  Object.assign(panel.style, {
    position: "fixed",
    bottom: "20px",
    right: "15px",
    width: "270px",
    background: "#17191f",
    color: "#fff",
    padding: "14px",
    borderRadius: "16px",
    zIndex: "999999",
    fontFamily: "Arial, sans-serif",
    boxShadow: "0 4px 20px #0005"
  });

  document.body.appendChild(panel);

  const result = panel.querySelector("#tp-result");

  panel.querySelector("#tp-close").onclick = () => {
    panel.remove();
  };

  panel.querySelector("#tp-analyze").onclick = () => {
    const text = document.body.innerText
      .replace(/\s+/g, " ")
      .slice(0, 12000);

    result.innerHTML = `
      <p>Страница проанализирована.</p>
      <p>Получено символов: ${text.length}</p>
      <p>Ожидается подключение AI.</p>
    `;
  };
})();
