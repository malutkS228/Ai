// TestPilot AI — Page Analyzer

(() => {
  if (window.testPilotLoaded) return;
  window.testPilotLoaded = true;

  chrome.runtime.onMessage.addListener(
    (message, sender, sendResponse) => {

      if (message.action === "ANALYZE_PAGE") {

        const pageText = document.body.innerText
          .replace(/\s+/g, " ")
          .slice(0, 15000);

        sendResponse({
          success: true,
          title: document.title,
          url: location.href,
          text: pageText
        });
      }
    }
  );
})();
